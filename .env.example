# Supabase project (public anon key — used client/server for insert-only form
# submissions, see supabase/migrations/ for the RLS policies this relies on).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production domain, used for metadataBase, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=

# Server-only. Lets /admin write insight posts and upload images (bypasses RLS,
# so it is used only after the admin check). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
